# Copy values into your shell environment. Spring Boot does not read this file automatically.
SPRING_PROFILES_ACTIVE=dev
PICKLE_DEV_ADMIN_USERNAME=admin
PICKLE_DEV_ADMIN_PASSWORD=
PICKLE_DEV_STAFF_USERNAME=staff
PICKLE_DEV_STAFF_PASSWORD=
PICKLE_SEED_ENABLED=false
PICKLE_FRONTEND_ORIGIN=http://localhost:5173

# Required for player signup, email verification and password recovery.
PICKLE_SMTP_HOST=
PICKLE_SMTP_PORT=587
PICKLE_SMTP_USERNAME=
PICKLE_SMTP_PASSWORD=
PICKLE_SMTP_AUTH=true
PICKLE_SMTP_STARTTLS=true
PICKLE_MAIL_FROM=
# At least 32 UTF-8 bytes; keep stable across restarts and all backend instances.
PICKLE_OTP_SECRET=

# dev and default profiles both use MySQL. Prefer application-local.properties for this machine.
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/picklezone?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=change-this-database-password
